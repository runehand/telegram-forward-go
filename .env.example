# Telegram ingest/forwarder
TG_API_ID=
TG_API_HASH=
TG_PHONE=+1XXXXXXXXXX
ZENFL_USERNAME=ZenflBot
TARGET_USERNAMES=@user1,@user2
TG_SESSION_FILE=session.json

# Backend API
APP_HTTP_ADDR=:8080
AUTH_JWT_SECRET=change-me

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=zenfl
MONGO_MESSAGES_COLLECTION=job_messages
MONGO_USERS_COLLECTION=users
MONGO_SEEN_COLLECTION=user_seen_jobs

# Logging
LOG_FORMAT=pretty
